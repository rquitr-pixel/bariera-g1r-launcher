{
  "name": "bariera-launcher",
  "productName": "Bariera Pierwsze Lata",
  "version": "1.0.3",
  "description": "Launcher serwera Bariera: Pierwsze Lata (G1R:MP)",
  "main": "main.js",
  "author": "Bariera",
  "scripts": {
    "start": "electron .",
    "dist:win:public": "node build-embed.js && electron-builder --win nsis --x64 --config electron-builder.public.js --publish never"
  },
  "build": {
    "appId": "pl.bariera.launcher",
    "productName": "Bariera Pierwsze Lata",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "package.json",
      "config/serwer.json",
      "embedded.js"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "helper",
        "to": "helper"
      }
    ],
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "Bariera Pierwsze Lata",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "language": "1045",
      "artifactName": "Bariera-Launcher-Setup.${ext}",
      "runAfterFinish": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "warningsAsErrors": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "rquitr-pixel",
        "repo": "bariera-g1r-launcher",
        "releaseType": "release"
      }
    ],
    "asar": true
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "repository": "https://github.com/rquitr-pixel/bariera-g1r-launcher",
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
